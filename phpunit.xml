<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Architecture rules (CLAUDE.md Articles 0 and 2) run first: if a boundary or
             the backend-only rule is broken, the rest of the result is noise. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
        </include>
    </source>
    <php>
        <!--
            CaseDocumentTest allocates a file one byte over the 10 MB ceiling to prove the refusal
            is a 413 and not a generic 422. A 10 MB string does not survive a stock 128 MB limit
            once the request body and its multipart copy exist beside it, and the failure arrives
            as "Premature end of PHP process", which reads as a broken runner rather than a missing
            setting.

            Pinned here rather than left to php.ini because Article 7.1 makes "php artisan test
            passes" the definition of done, and a definition of done that depends on an ini value
            the repository does not ship is not one. `php artisan test` spawns a child process, so
            `php -d memory_limit=...` on the parent does not reach the tests; this does.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <!--
            The suite never writes a credential to a log, whatever .env says.

            CredentialLeakageTest holds a flat invariant: a one-time code never reaches the log.
            LogTransactionalSender breaks it by design, so a developer can exercise sign in.
            Running the suite with a developer .env loaded (php artisan test env=integration)
            turned that sender on, and the invariant caught it, correctly.

            Pinned here rather than detected at runtime: the env flag overrides the APP_ENV above,
            so neither the environment name nor runningUnitTests answers "is this the suite". A
            test that needs to see what was sent binds its own capture sender, which is both safer
            and a better test. See SignInCodeDeliveryTest.
        -->
        <env name="TRANSACTIONAL_SENDER" value="null"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
