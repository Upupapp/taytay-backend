# Taytay Rizal LGU IDS — backend environment template.
#
# Real values live in the environment only. Never commit a populated .env, and never echo
# a secret into a test, fixture, doc or error message (CLAUDE.md Article 5.6).

APP_NAME="Taytay LGU IDS"
APP_ENV=local
APP_KEY=
# APP_DEBUG must be false everywhere except a developer machine: the API error renderer
# attaches exception detail to 500 responses when it is true.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# The application timezone is fixed to UTC in config/app.php and is deliberately not
# environment-tunable: the API emits ISO-8601 UTC (docs/api/conventions.md §6).

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is for local development and tests only. Real environments use PostgreSQL or
# MySQL (CLAUDE.md Article 1).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=lguids
# DB_USERNAME=
# DB_PASSWORD=

# This backend serves no browser UI of its own; sessions exist only for Sanctum's
# cookie mode should the citizen web portal adopt it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Comma-separated hostnames of the first-party frontends permitted to authenticate with
# Sanctum cookies. Leave empty for token-only authentication.
# SANCTUM_STATEFUL_DOMAINS=

# Comma-separated origins of the first-party BROWSER clients (citizen portal, admin
# console). Empty means no cross-origin browser request is allowed — deny by default.
# The Flutter app and verifier devices are not browsers and need nothing here.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@taytayrizal.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"
