# Taytay Rizal LGU IDS — backend environment template.
#
# Copy to `.env`, then `php artisan key:generate`.
#
# The defaults below are the LOCAL DOCKER COMPOSE STACK (docker-compose.yml): PostgreSQL,
# Redis, MinIO and Mailpit. They mirror the production topology in ADR 0004 on purpose, so
# that "it works on my machine" means something. A no-Docker fallback is at the bottom.
#
# EVERY VALUE HERE IS A LOCAL PLACEHOLDER OR EMPTY. Real credentials live in the
# environment only — never in this file, never in a commit, never echoed into a log, test,
# fixture, doc or error message (CLAUDE.md Article 5.6). Deployed environments inject
# secrets from the platform; see docs/runbooks/environments-and-secrets.md.
#
# Boot and verify:  docker compose up -d --wait && php artisan lguids:readiness

APP_NAME="Taytay LGU IDS"
APP_ENV=local
APP_KEY=
# APP_DEBUG must be false everywhere except a developer machine: the API error renderer
# attaches exception detail to 500 responses when it is true.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# The application timezone is fixed to UTC in config/app.php and is deliberately not
# environment-tunable: the API emits ISO-8601 UTC (docs/api/conventions.md §6).

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# `stack` -> `single` locally. Deployed environments log to stderr for the platform to
# collect. Never log a government identifier, credential, token or full address
# (CLAUDE.md Article 5.5).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────────────
# PostgreSQL is canonical (CLAUDE.md Article 1, ADR 0004). Locally it is the `postgres`
# service in docker-compose.yml; deployed it is Akamai Managed PostgreSQL, reachable only
# from the application tier over the private network.
# The automated test suite ignores all of this and uses in-memory SQLite (phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lguids
DB_USERNAME=lguids
DB_PASSWORD=lguids_local_password
# Managed PostgreSQL must be encrypted in transit. `prefer` is fine against a local
# container; every deployed environment sets `require`.
DB_SSLMODE=prefer
# Host port to publish the container on, if 5432 is already taken.
# DB_HOST_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────────────
# Queues, cache, locks and rate limits. Private network only — never publicly reachable,
# and password-protected in every deployed environment (CLAUDE.md Article 8.6).
# `predis` is the pure-PHP client and needs no extension, which is why it is the default.
# Deployed hosts should install the phpredis extension and set REDIS_CLIENT=phpredis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# REDIS_HOST_PORT=6379

# ── Cache, queue, session, broadcast ──────────────────────────────────────────────────
CACHE_STORE=redis
# CACHE_PREFIX=
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# This backend serves no browser UI of its own. ADR 0005 chose first-party bearer tokens
# over Sanctum cookie/SPA mode, so no session cookie crosses an origin — leave
# SESSION_DOMAIN unset and do NOT widen it to ".<domain>".
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum cookie/SPA mode is deliberately NOT used (ADR 0005, ADR 0006). Leave this empty;
# setting it re-enables stateful cookie auth and the CSRF/CORS surface those decisions
# avoided.
# SANCTUM_STATEFUL_DOMAINS=

# ── Edge: proxies and cross-origin ────────────────────────────────────────────────────
# Trusted reverse proxies (Nginx, and NodeBalancer once there is more than one node).
# EMPTY MEANS TRUST NOTHING, which is correct for local development.
# Set this in every deployed environment: without it Laravel reads the proxy as the
# client, so rate limiting collapses to one shared key, signed URLs get the wrong scheme,
# and audit trails attribute every action to the load balancer.
# Use the private-network CIDR rather than "*" wherever possible.
# TRUSTED_PROXIES=10.0.0.0/8

# Comma-separated origins of the first-party BROWSER clients hosted on Netlify — the
# citizen portal and admin console for THIS environment. Empty means no cross-origin
# browser request is allowed (deny by default). The Flutter app and verifier devices are
# not browsers and need nothing here.
#   local:      http://localhost:4200,http://localhost:5173
#   staging:    https://portal-staging.<domain>,https://admin-staging.<domain>
#   production: https://portal.<domain>,https://admin.<domain>
# Never add a provider-generated preview origin to a production API.
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Object storage ────────────────────────────────────────────────────────────────────
# Akamai (Linode) Object Storage — S3-compatible and PRIVATE (ADR 0004). Holds citizen
# documents, ID artifacts and case attachments. Use least-privilege keys scoped to this
# environment's bucket only, and never configure a public base URL. Objects reach a
# citizen through an authorization-gated endpoint or a short-lived signed URL issued after
# a server-side authorization decision.
#
# Locally this is the MinIO service, which speaks the same S3 API. Set FILESYSTEM_DISK to
# `object-storage` to exercise the real code path; `local` is the lighter default.
FILESYSTEM_DISK=local
OBJECT_STORAGE_KEY=lguids_local_key
OBJECT_STORAGE_SECRET=lguids_local_secret
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=lguids-local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# MinIO needs path-style addressing; Akamai Object Storage does not.
OBJECT_STORAGE_PATH_STYLE=true
# OBJECT_STORAGE_HOST_PORT=9000
# OBJECT_STORAGE_CONSOLE_PORT=9001
#
# Deployed values look like:
#   OBJECT_STORAGE_REGION=ap-south-1
#   OBJECT_STORAGE_ENDPOINT=https://ap-south-1.linodeobjects.com
#   OBJECT_STORAGE_PATH_STYLE=false

# ── Mail ──────────────────────────────────────────────────────────────────────────────
# Mailpit catches everything locally so a developer can never send a real message to a
# resident. Web UI: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@taytayrizal.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_HOST_PORT=1025
# MAILPIT_UI_PORT=8025

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────────────
# Push TRANSPORT only; Laravel remains the notification authority (ADR 0004). Separate
# Firebase projects for staging and production. FCM_CREDENTIALS_PATH points at a
# service-account file kept OUTSIDE the repository; its contents are secret and must never
# be committed, logged or echoed. Unset locally — nothing sends push from a laptop.
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=/etc/lguids/fcm-service-account.json

# ── No Docker? ────────────────────────────────────────────────────────────────────────
# Swap the four lines below in and the application runs with no services at all. You lose
# PostgreSQL parity (SQLite differs on transactions, types and constraints), background
# queue behaviour, and the object-storage code path — so run the Docker stack before
# trusting anything infrastructure-shaped.
#   DB_CONNECTION=sqlite
#   DB_DATABASE=              (leave EMPTY — it then defaults to database/database.sqlite;
#                              the `lguids` value above is a Postgres database name and
#                              SQLite would try to open a file called "lguids")
#   CACHE_STORE=file
#   QUEUE_CONNECTION=sync
#   MAIL_MAILER=log
# Then: touch database/database.sqlite && php artisan migrate
