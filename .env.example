# Taytay Rizal LGU IDS — backend environment template.
#
# Real values live in the environment only. Never commit a populated .env, and never echo
# a secret into a test, fixture, doc or error message (CLAUDE.md Article 5.6).

APP_NAME="Taytay LGU IDS"
APP_ENV=local
APP_KEY=
# APP_DEBUG must be false everywhere except a developer machine: the API error renderer
# attaches exception detail to 500 responses when it is true.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# The application timezone is fixed to UTC in config/app.php and is deliberately not
# environment-tunable: the API emits ISO-8601 UTC (docs/api/conventions.md §6).

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is for local development and tests only. Real environments use PostgreSQL —
# Akamai Managed PostgreSQL where regionally available (CLAUDE.md Article 1, ADR 0004).
# The database is reachable only from the application tier over the private network.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=lguids
# DB_USERNAME=
# DB_PASSWORD=
# Managed PostgreSQL must be encrypted in transit.
# DB_SSLMODE=require

# Trusted reverse proxies (Nginx, and NodeBalancer once there is more than one node).
# EMPTY MEANS TRUST NOTHING, which is correct for local development.
# Set this in every deployed environment: without it Laravel reads the proxy as the
# client, so rate limiting collapses to one shared key, signed URLs get the wrong scheme,
# and audit trails attribute every action to the load balancer.
# Use the private-network CIDR rather than "*" wherever possible.
# TRUSTED_PROXIES=10.0.0.0/8

# This backend serves no browser UI of its own. ADR 0005 chose first-party bearer tokens
# over Sanctum cookie/SPA mode, so no session cookie crosses an origin — leave
# SESSION_DOMAIN unset and do NOT widen it to ".<domain>".
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum cookie/SPA mode is deliberately NOT used (ADR 0005). Leave this empty; setting
# it re-enables stateful cookie auth and the CSRF/CORS surface that decision avoided.
# SANCTUM_STATEFUL_DOMAINS=

# Comma-separated origins of the first-party BROWSER clients hosted on Netlify — the
# citizen portal and admin console for THIS environment. Empty means no cross-origin
# browser request is allowed (deny by default). The Flutter app and verifier devices are
# not browsers and need nothing here.
#   production: https://portal.<domain>,https://admin.<domain>
#   staging:    https://portal-staging.<domain>,https://admin-staging.<domain>
# Never add a provider-generated preview origin to a production API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Local disk for development; deployed environments use "object-storage".
FILESYSTEM_DISK=local

# Akamai (Linode) Object Storage — S3-compatible, PRIVATE (ADR 0004).
# Holds citizen documents, ID artifacts and case attachments. Use least-privilege keys
# scoped to this environment's bucket only, and never configure a public base URL.
# Objects reach a citizen through an authorization-gated endpoint or a short-lived signed
# URL issued after a server-side authorization decision.
# OBJECT_STORAGE_KEY=
# OBJECT_STORAGE_SECRET=
# OBJECT_STORAGE_REGION=ap-south-1
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ENDPOINT=https://ap-south-1.linodeobjects.com
# OBJECT_STORAGE_PATH_STYLE=false

# Firebase Cloud Messaging — push TRANSPORT only; Laravel remains the notification
# authority (ADR 0004). Separate Firebase projects for staging and production.
# FCM_CREDENTIALS_PATH points at a service-account file kept OUTSIDE the repository; its
# contents are secret and must never be committed, logged or echoed.
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=/etc/lguids/fcm-service-account.json

# Redis backs queues, cache, locks and rate limits. Private network only — never exposed
# publicly, and password-protected in every deployed environment.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@taytayrizal.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"
